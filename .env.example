# MindTrack Environment Configuration

# ============================================
# AI SUMMARY GENERATION
# ============================================
# Google Gemini API Key for generating clinical summaries
# Get your API key from: https://makersuite.google.com/app/apikey
# Optional - AI summaries will gracefully fail if not provided
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# SESSION MANAGEMENT
# ============================================
# Secret key for session encryption
# Generate a secure random string (recommended: 32+ characters)
# Will auto-generate if not provided
SESSION_SECRET=your_session_secret_here

# ============================================
# SERVER CONFIGURATION
# ============================================
# Application environment (development | production)
NODE_ENV=development

# Port number for the server (default: 5000)
# Note: In production, this may be overridden by hosting platform
PORT=5000

# ============================================
# OPTIONAL: DATABASE (Future Use)
# ============================================
# PostgreSQL connection string (not currently used)
# DATABASE_URL=postgresql://user:password@localhost:5432/mindtrack

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file to .env
#    $ cp .env.example .env
#
# 2. Fill in your actual values (especially GEMINI_API_KEY)
#
# 3. Never commit .env to version control
#    (already included in .gitignore)
#
# 4. Restart the server after changing values
#    $ npm run dev
